# General
NODE_ENV=development
TZ=America/Bogota
API_PORT=3001
WEB_PORT=3000
POSTGRES_PORT=5432
REDIS_PORT=6379
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
NEXT_PUBLIC_API_URL=http://localhost:3001/api

# Database
DATABASE_URL=postgresql://bdpolitica:bdpolitica_dev@localhost:5432/bdpolitica?schema=public
# En Docker (API container): postgresql://bdpolitica:bdpolitica_dev@postgres:5432/bdpolitica?schema=public

# Redis
REDIS_URL=redis://localhost:6379
# En Docker (API container): redis://redis:6379

# Object Storage (S3 compatible)
S3_ENDPOINT=http://localhost:9000
# En Docker (API container): http://minio:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=bdpolitica-files
S3_FORCE_PATH_STYLE=true

# Auth
ACCESS_TOKEN_SECRET=replace_with_at_least_32_random_chars
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d
DEV_ADMIN_PASSWORD=replace_admin_password
DEV_COORDINADOR_PASSWORD=replace_coordinador_password
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Security
ALLOWED_ORIGINS=http://localhost:3000
BCRYPT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
LOGIN_MAX_ATTEMPTS=5
LOGIN_BLOCK_MINUTES=15
